{
  "name": "career-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "node scripts/check-secrets.mjs",
    "secrets:dist": "node scripts/check-secrets.mjs --dist",
    "check": "npm run secrets && npm run typecheck && npm test && npm run build && npm run secrets:dist"
  },
