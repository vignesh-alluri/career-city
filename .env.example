# Copy this file to .env.local and fill in your own values. NEVER commit .env.local.
# Found in Supabase: Project Settings > API Keys. Use ONLY the public key here
# (the "anon" key or the "publishable" key that starts with sb_publishable_).
# The service_role / secret key must never be placed in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-key
